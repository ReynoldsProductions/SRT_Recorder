{
	"name": "companion-module-c2c-console",
	"version": "0.1.0",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "node --test test/"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ReynoldsProductions/SRT_Recorder.git",
		"directory": "companion-module"
	},
	"engines": {
		"node": "^26",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.2.2"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.2.1",
		"@types/node": "^26.6.4",
		"eslint": "^10.12.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.9",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.18.1",
	"description": "Bitfocus Companion module for the Camera2Cloud (C2C) SRT recording console"
}
