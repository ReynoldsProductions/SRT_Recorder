# DMZ relay host. Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Generate secrets with:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"

# --- config sync (relay -> console, read-only) ---
# Console URL on the internal host. Use https. This must be the console's C2C_SYNC_TOKEN, nothing else.
SYNC_URL=https://CHANGE_ME:3020/api/relay/inputs
SYNC_TOKEN=CHANGE_ME
# Only set to 1 for a link you trust end to end (the response carries camera passphrases).
SYNC_ALLOW_INSECURE_HTTP=

# --- backhaul to OvenMediaEngine (internal host) ---
OME_SRT_HOST=CHANGE_ME
OME_SRT_PORT=9999
# Same value as OME_SRT_PASSPHRASE on the internal host. Distinct from every camera passphrase.
OME_SRT_PASSPHRASE=CHANGE_ME

# --- ports (one UDP port per camera; 6 provisioned) ---
RELAY_PORT_MIN=8897
RELAY_PORT_MAX=8902
