# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Generate secrets with:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"

# --- secrets ---
OME_API_TOKEN=CHANGE_ME
C2C_CONSOLE_PASSWORD=CHANGE_ME
# Bearer key for Bitfocus Companion (optional, >= 24 chars)
C2C_API_KEY=CHANGE_ME

# --- paths ---
# Where OME writes recordings (<shoot>/<input>/<clip>_T###_<time>.ts). Use encrypted storage for real footage.
RECORDINGS_DIR=/srv/srt-recorder/recordings
# Console state + input registry (inputs.json holds the per-camera SRT passphrases; keep it private)
C2C_DATA_DIR=./data

# --- network / display ---
# IP or hostname cameras connect to (shown in each input's "Camera setup")
PUBLIC_HOST=192.168.1.10
# Where operators can find recordings (shown in the UI), e.g. an SMB share
RECORDINGS_SHARE=
CONSOLE_PORT=3020
RELAY_PORT_MIN=8897
RELAY_PORT_MAX=8912
# First-run seed only; afterwards inputs are managed in the console UI
SEED_INPUTS=cam1:8897
# Local time zone for file names
TZ=America/Los_Angeles
