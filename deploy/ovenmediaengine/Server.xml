<?xml version="1.0" encoding="UTF-8" ?>
<!--
  OvenMediaEngine config for SRT_Recorder (tested with ovenmedialabs/ovenmediaengine:v0.21.0).

  - SRT provider on :9999 has NO passphrase: never publish it to the host/LAN. Only c2c-relay
    (which terminates camera encryption) should reach it, over the internal docker network.
  - FILE publisher: recordings are started/stopped by c2c-console via the REST API with
    per-recording filePath/infoPath; the FilePath below is only the fallback pattern.
    Use "hh" (not "HH") for hours in ${StartTime:...} tokens.
  - LL-HLS on :3333 feeds the console's authenticated preview proxy (also not host-published).
  - The API token comes from the OME_API_TOKEN environment variable.
-->
<Server version="8">
	<Name>SRT_Recorder</Name>
	<Type>origin</Type>
	<IP>*</IP>
	<PrivacyProtection>false</PrivacyProtection>

	<Modules>
		<HTTP2>
			<Enable>true</Enable>
		</HTTP2>
		<LLHLS>
			<Enable>true</Enable>
		</LLHLS>
		<P2P>
			<Enable>false</Enable>
		</P2P>
	</Modules>

	<Bind>
		<!-- API reachable only inside the docker network (ts-ovenmediaengine sidecar), never published to host -->
		<Managers>
			<API>
				<Port>8081</Port>
				<WorkerCount>1</WorkerCount>
			</API>
		</Managers>
		<Providers>
			<SRT>
				<Port>9999</Port>
				<WorkerCount>1</WorkerCount>
			</SRT>
		</Providers>
		<Publishers>
			<!-- LL-HLS for the c2c-console confidence preview (passthrough, no transcode).
			     Port is NOT published to the host: the console proxies it behind its login.
			     RTMP/WebRTC/HLSv3 remain disabled. -->
			<LLHLS>
				<Port>3333</Port>
				<WorkerCount>1</WorkerCount>
			</LLHLS>
		</Publishers>
	</Bind>

	<Managers>
		<API>
			<AccessToken>${env:OME_API_TOKEN}</AccessToken>
		</API>
	</Managers>

	<Defaults>
		<CrossDomains>
			<Url>*</Url>
		</CrossDomains>
	</Defaults>

	<VirtualHosts>
		<VirtualHost>
			<Name>default</Name>
			<Host>
				<Names>
					<Name>*</Name>
				</Names>
			</Host>
			<CrossDomains>
				<Url>*</Url>
			</CrossDomains>

			<Applications>
				<Application>
					<Name>app</Name>
					<Type>live</Type>
					<OutputProfiles>
						<OutputProfile>
							<Name>bypass_stream</Name>
							<OutputStreamName>${OriginStreamName}</OutputStreamName>
							<Encodes>
								<!-- Bypass preserves the original video track untouched, per the
								     test plan's requirement to confirm no inadvertent transcoding. -->
								<Video>
									<Name>bypass_video</Name>
									<Bypass>true</Bypass>
								</Video>
								<Audio>
									<Name>bypass_audio</Name>
									<Bypass>true</Bypass>
								</Audio>
							</Encodes>
						</OutputProfile>
					</OutputProfiles>
					<Providers>
						<!-- Not camera-facing: fed only by c2c-relay over the internal network. -->
						<SRT />
					</Providers>
					<Publishers>
						<AppWorkerCount>1</AppWorkerCount>
						<StreamWorkerCount>1</StreamWorkerCount>
						<LLHLS>
							<ChunkDuration>0.5</ChunkDuration>
							<SegmentDuration>4</SegmentDuration>
							<SegmentCount>6</SegmentCount>
						</LLHLS>
						<FILE>
							<RootPath>/recordings</RootPath>
							<FilePath>${TransactionId}/${StartTime:YYYYMMDDhhmmss}_${EndTime:YYYYMMDDhhmmss}.ts</FilePath>
							<InfoPath>${TransactionId}/${StartTime:YYYYMMDDhhmmss}_${EndTime:YYYYMMDDhhmmss}.xml</InfoPath>
						</FILE>
					</Publishers>
				</Application>
			</Applications>
		</VirtualHost>
	</VirtualHosts>
</Server>
