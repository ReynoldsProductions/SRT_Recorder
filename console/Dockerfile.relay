# c2c-relay — SRT relay manager (one ffmpeg listener per input). Shares code with c2c-console.
#
# Base: linuxserver/ffmpeg 9.0.2 (libsrt 1.5.7). NOT Alpine: Alpine's libsrt 1.5.3 fails the
# Sony FX2's SRT handshake ("Error opening input: I/O error"), verified 2026-11-24.
# Node 24 is copied from the official Debian image (both pinned by digest).
FROM node@sha256:873f586f3794f52281bd039bf02c048a0be08fde619338f9941bad1eb6b34530 AS node
FROM linuxserver/ffmpeg@sha256:66fa8e2351fb78f9dad2c59c946be2658edcc529339320da3f2cf788312368af
COPY --from=node /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
COPY package.json ./
COPY src ./src
# Same uid as the console (owner of the 0600 inputs.json it writes).
USER 1000:1000
EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD node -e "fetch('http://127.0.0.1:8090/healthz').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
ENTRYPOINT []
CMD ["node", "src/relay/manager.js"]
